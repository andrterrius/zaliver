# Zaliver API — systemd unit
#
# Install (path к репо поправьте при необходимости):
#   cp scripts/api/zaliver-api.service /etc/systemd/system/
#   mkdir -p /etc/zaliver
#   cp scripts/api/zaliver-api.env.example /etc/zaliver/api.env
#   nano /etc/zaliver/api.env
#   systemctl daemon-reload
#   systemctl enable --now zaliver-api
#   systemctl status zaliver-api
#   journalctl -u zaliver-api -f

[Unit]
Description=Zaliver API (web UI + video jobs)
Documentation=file:///root/zaliver/web/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/zaliver

# Optional env overrides (token, port, workers). File may be missing.
EnvironmentFile=-/etc/zaliver/api.env

Environment=PYTHONPATH=/root/zaliver/src
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=ZALIVER_API_HOST=127.0.0.1
Environment=ZALIVER_API_PORT=8080

# Prefer .venv only (system python often lacks patchright / api deps).
ExecStart=/root/zaliver/.venv/bin/python -m zaliver.api

Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Keep API preferred over ffmpeg children under memory pressure.
OOMPolicy=continue
OOMScoreAdjust=-200

# Video jobs open many files / pipes.
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zaliver-api

[Install]
WantedBy=multi-user.target
