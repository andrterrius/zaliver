# Copy to /etc/zaliver/api.env and edit:
#   mkdir -p /etc/zaliver
#   cp scripts/api/zaliver-api.env.example /etc/zaliver/api.env

ZALIVER_API_TOKEN=secret
ZALIVER_API_HOST=127.0.0.1
ZALIVER_API_PORT=8080

# Safer on small VPS (ffmpeg is RAM-heavy):
ZALIVER_API_MAX_JOBS=1
ZALIVER_API_MAX_WORKERS=2
