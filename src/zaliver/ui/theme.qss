
* {
    font-family: "Segoe UI", "SF Pro Display", system-ui, sans-serif;
    font-size: 13px;
    color: #e4e6ef;
}

QMainWindow, QWidget#zaliverRoot {
    background-color: #12141c;
}

QGroupBox {
    background-color: #1a1d26;
    border: 1px solid #2d3142;
    border-radius: 12px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
    font-weight: 600;
    color: #c7c9d9;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 8px;
    color: #a5b4fc;
}

QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0f1118;
    border: 1px solid #2d3142;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: #6366f1;
    min-height: 20px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #6366f1;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6366f1, stop:1 #7c3aed);
    color: #f8fafc;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #818cf8, stop:1 #8b5cf6);
}

QPushButton:pressed {
    background: #4f46e5;
}

QPushButton#secondary {
    background-color: #252836;
    color: #e4e6ef;
    border: 1px solid #3d4258;
}

QPushButton#secondary:hover {
    background-color: #2e3245;
    border: 1px solid #6366f1;
}

QPushButton#danger {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #be123c, stop:1 #9f1239);
}

QPushButton#danger:hover {
    background: #e11d48;
}

QPlainTextEdit {
    background-color: #0f1118;
    border: 1px solid #2d3142;
    border-radius: 10px;
    padding: 8px;
    font-family: Consolas, "Cascadia Mono", monospace;
    font-size: 11px;
    color: #a8b0d4;
    line-height: 1.4;
}

QProgressBar {
    border: none;
    border-radius: 8px;
    background-color: #1e2230;
    text-align: center;
    color: #e4e6ef;
    min-height: 22px;
    max-height: 22px;
}

QProgressBar::chunk {
    border-radius: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1, stop:1 #a855f7);
}

QCheckBox {
    spacing: 10px;
    color: #c7c9d9;
    min-height: 20px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 1px solid #3d4258;
    background-color: #0f1118;
}

QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6366f1, stop:1 #7c3aed);
    border: 1px solid #818cf8;
}

QLabel {
    min-height: 16px;
    line-height: 1.3;
}

QLabel#title {
    font-size: 22px;
    font-weight: 700;
    color: #f1f5f9;
    letter-spacing: 0.5px;
}

QLabel#hint {
    color: #6b7280;
    font-size: 11px;
}

QScrollArea {
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QSplitter::handle {
    background-color: #2d3142;
    width: 4px;
    border-radius: 2px;
}

QScrollBar:vertical {
    background: #1a1d26;
    width: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #3d4258;
    min-height: 28px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #6366f1;
}

QListWidget#sideNav {
    background-color: #1a1d26;
    border: 1px solid #2d3142;
    border-radius: 12px;
    padding: 8px 4px;
    outline: none;
}

QListWidget#sideNav::item {
    padding: 12px 14px;
    border-radius: 8px;
    color: #c7c9d9;
    min-height: 20px;
}

QListWidget#sideNav::item:hover {
    background-color: #252836;
}

QListWidget#sideNav::item:selected {
    background-color: #2e3245;
    border: 1px solid #6366f1;
    color: #f1f5f9;
}

QListWidget#readyList {
    background-color: #0f1118;
    border: 1px solid #2d3142;
    border-radius: 12px;
    padding: 8px;
}

QListWidget#readyList::item {
    padding: 8px;
    border-radius: 10px;
    min-height: 20px;
}

QListWidget#readyList::item:hover {
    background-color: #1a1d26;
}

QListWidget#readyList::item:selected {
    background-color: #252836;
    border: 1px solid #6366f1;
}

/* Фоновые треки (главная) — как списки профилей / готовых */
QListWidget#musicTracksList {
    background-color: #0f1118;
    border: 1px solid #2d3142;
    border-radius: 12px;
    padding: 8px;
    outline: none;
}

QListWidget#musicTracksList::item {
    padding: 8px 10px;
    border-radius: 8px;
    min-height: 18px;
    color: #e4e6ef;
}

QListWidget#musicTracksList::item:hover {
    background-color: rgba(99, 102, 241, 0.10);
}

QListWidget#musicTracksList::item:selected {
    background-color: rgba(99, 102, 241, 0.16);
    border: 1px solid #6366f1;
    color: #f1f5f9;
}

QLabel#readyRowNumber {
    font-size: 34px;
    font-weight: 800;
    color: #a5b4fc;
    letter-spacing: -1px;
    background-color: transparent;
}

QLabel#readyRowTitle {
    font-size: 14px;
    font-weight: 600;
    color: #f1f5f9;
}

QLabel#readyRowDate {
    font-size: 12px;
    color: #94a3b8;
}

QLabel#readyThumb {
    background-color: #0f1118;
    border: 1px solid #2d3142;
    border-radius: 10px;
}

QLabel#readyThumbEmpty {
    background-color: #1a1d26;
    border: 1px dashed #3d4258;
    border-radius: 10px;
    color: #6b7280;
    font-size: 11px;
}

/* Antic (antydetect) profiles list */
QListWidget#profilesList {
    background-color: #0f1118;
    border: 1px solid #2d3142;
    border-radius: 12px;
    padding: 8px;
    outline: none;
}

QListWidget#profilesList::item {
    padding: 4px;
    border-radius: 12px;
    background: transparent;
}

QListWidget#profilesList::item:hover {
    background-color: rgba(99, 102, 241, 0.10);
}

QListWidget#profilesList::item:selected {
    background-color: rgba(99, 102, 241, 0.16);
    border: 1px solid #6366f1;
}

QListWidget#uploadProfilesList {
    background-color: #0f1118;
    border: 1px solid #2d3142;
    border-radius: 12px;
    padding: 8px;
    outline: none;
}

QListWidget#uploadProfilesList::item {
    padding: 4px;
    border-radius: 12px;
    background: transparent;
}

QListWidget#uploadProfilesList::item:hover {
    background-color: rgba(99, 102, 241, 0.10);
}

QListWidget#uploadProfilesList::item:selected {
    background-color: rgba(99, 102, 241, 0.16);
    border: 1px solid #6366f1;
}

QWidget#anticProfileRowRoot {
    background: transparent;
    min-width: 0;
    min-height: 104px;
}

QCheckBox#anticProfileSelectCheck {
    spacing: 6px;
}

QCheckBox#anticProfileSelectCheck::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #4b5568;
    background-color: #151826;
}

QCheckBox#anticProfileSelectCheck::indicator:hover {
    border-color: #6366f1;
}

QCheckBox#anticProfileSelectCheck::indicator:checked {
    border-color: #6366f1;
    background-color: rgba(99, 102, 241, 0.35);
}

QFrame#anticProfileAccent {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6366f1, stop:1 #a855f7);
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
}

QFrame#anticProfileCard {
    background-color: #151826;
    border: 1px solid #2d3142;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

QLabel#anticProfileTitle {
    font-size: 14px;
    font-weight: 700;
    color: #f1f5f9;
    min-width: 0;
}

QLabel#anticProfileSubtitle {
    font-size: 11px;
    color: #94a3b8;
    min-width: 0;
}

QLabel#anticProfileDescription {
    font-size: 12px;
    color: #a8b3cf;
    min-width: 0;
}

QLabel#anticProfileTag {
    font-size: 10px;
    font-weight: 600;
    color: #ddd6fe;
    background-color: rgba(139, 92, 246, 0.20);
    border: 1px solid rgba(167, 139, 250, 0.38);
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 26px;
}

QLabel#anticProfileTag[tagSemantic="error"] {
    color: #ffe4e6;
    background-color: rgba(244, 63, 94, 0.14);
    border: 1px solid rgba(251, 113, 133, 0.35);
}

QLabel#anticProfileTag[tagSemantic="success"] {
    color: #dcfce7;
    background-color: rgba(34, 197, 94, 0.14);
    border: 1px solid rgba(74, 222, 128, 0.35);
}

QLabel#anticProfileUpload {
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    min-width: 0;
}

QLabel#anticProfileUpload[uploadCooldown="ok"] {
    color: #dcfce7;
    background-color: rgba(34, 197, 94, 0.14);
    border: 1px solid rgba(74, 222, 128, 0.35);
}

QLabel#anticProfileUpload[uploadCooldown="wait"] {
    color: #ffedd5;
    background-color: rgba(249, 115, 22, 0.14);
    border: 1px solid rgba(251, 146, 60, 0.38);
}

QLabel#anticProfileUpload[uploadCooldown="none"] {
    color: #94a3b8;
    background-color: rgba(148, 163, 184, 0.10);
    border: 1px dashed rgba(148, 163, 184, 0.30);
}

QLabel#anticProfileUpload[uploadCooldown="unknown"] {
    color: #e5e7eb;
    background-color: rgba(148, 163, 184, 0.12);
    border: 1px solid rgba(148, 163, 184, 0.28);
}

QLabel#anticProfileId,
QLabel#anticProfileStatus,
QLabel#anticProfileProxy {
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
}

QLabel#anticProfileId {
    color: #c7d2fe;
    background-color: rgba(99, 102, 241, 0.14);
    border: 1px solid rgba(129, 140, 248, 0.35);
    border-radius: 999px;
}

QLabel#anticProfileStatus {
    color: #ede9fe;
    background-color: rgba(124, 58, 237, 0.18);
    border: 1px solid rgba(167, 139, 250, 0.35);
    border-radius: 999px;
}

QLabel#anticProfileProxy {
    color: #c7d2fe;
    background-color: rgba(99, 102, 241, 0.10);
    border: 1px solid rgba(129, 140, 248, 0.28);
    border-radius: 999px;
    min-width: 0;
}

QLabel#anticProfileProxy[proxyState="ok"] {
    color: #dcfce7;
    background-color: rgba(34, 197, 94, 0.14);
    border: 1px solid rgba(74, 222, 128, 0.35);
}

QLabel#anticProfileProxy[proxyState="bad"] {
    color: #ffe4e6;
    background-color: rgba(244, 63, 94, 0.14);
    border: 1px solid rgba(251, 113, 133, 0.35);
}

QLabel#anticProfileProxy[proxyState="unknown"] {
    color: #e5e7eb;
    background-color: rgba(148, 163, 184, 0.12);
    border: 1px solid rgba(148, 163, 184, 0.28);
}

QLabel#anticProfileProxy[proxyState="none"] {
    color: #94a3b8;
    background-color: rgba(148, 163, 184, 0.08);
    border: 1px dashed rgba(148, 163, 184, 0.28);
}

/* Залитые видео — фирменный фиолетово-белый стиль (как в остальном UI) */
QFrame#uploadedSidePanel {
    background-color: #151826;
    border: 1px solid rgba(129, 140, 248, 0.35);
    border-radius: 12px;
}

QLabel#uploadedSideTitle {
    font-size: 18px;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: 0.3px;
}

QFrame#uploadedStatTile {
    background-color: #0f1118;
    border: 1px solid rgba(99, 102, 241, 0.28);
    border-radius: 10px;
}

QLabel#uploadedStatTileTitle {
    font-size: 10px;
    font-weight: 700;
    color: #a5b4fc;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}

QLabel#uploadedStatTileValue {
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
}

QLabel#uploadedMetricName {
    font-size: 12px;
    font-weight: 700;
    color: #e4e6ef;
}

QLabel#uploadedMetricYellow {
    font-size: 13px;
    font-weight: 800;
    color: #fde68a;
}

QLabel#uploadedMetricGreen {
    font-size: 13px;
    font-weight: 800;
    color: #ddd6fe;
}

QLabel#uploadedMetricRed {
    font-size: 13px;
    font-weight: 800;
    color: #f9a8d4;
}

QLabel#uploadedSideAvg {
    font-size: 12px;
    font-weight: 700;
    color: #c7d2fe;
    padding-top: 6px;
}

QPushButton#uploadedCheckBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6366f1, stop:1 #7c3aed);
    color: #f8fafc;
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: 800;
    min-width: 120px;
}

QPushButton#uploadedCheckBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #818cf8, stop:1 #8b5cf6);
    color: #ffffff;
}

QPushButton#uploadedCheckBtn:pressed {
    background: #4f46e5;
    color: #f8fafc;
}

QPushButton#uploadedCheckBtn:disabled {
    background: #252836;
    color: #64748b;
    border: 1px solid #3d4258;
}

QLabel#uploadedSectionHint {
    font-size: 13px;
    font-weight: 600;
    color: #e2e8f0;
    letter-spacing: 0.15px;
    line-height: 1.45;
    padding: 2px 0 4px 0;
}

QLabel#uploadedSortCaption {
    font-size: 13px;
    font-weight: 800;
    color: #f1f5f9;
}

QPushButton#uploadedSortActive {
    background-color: rgba(99, 102, 241, 0.22);
    color: #e0e7ff;
    border: 1px solid rgba(129, 140, 248, 0.55);
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 800;
}

QPushButton#uploadedSortActive:hover {
    background-color: rgba(99, 102, 241, 0.32);
    border-color: #a5b4fc;
}

QPushButton#uploadedSortInactive {
    background-color: #252836;
    color: #94a3b8;
    border: 1px solid #3d4258;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 700;
}

QPushButton#uploadedSortInactive:hover {
    border-color: #6366f1;
    color: #e4e6ef;
}

QListWidget#uploadedList {
    background-color: #0f1118;
    border: 1px solid rgba(99, 102, 241, 0.22);
    border-radius: 12px;
    padding: 6px;
}

QListWidget#uploadedList::item {
    padding: 4px;
    border-radius: 10px;
    min-height: 20px;
}

QListWidget#uploadedList::item:hover {
    background-color: rgba(99, 102, 241, 0.08);
}

QListWidget#uploadedList::item:selected {
    background-color: rgba(99, 102, 241, 0.16);
    border: 1px solid #6366f1;
}

QLabel#uploadedRowTitle {
    font-size: 15px;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: 0.2px;
}

QLabel#uploadedRowId {
    font-size: 12px;
    font-weight: 800;
    font-family: "Segoe UI", "SF Mono", "Consolas", monospace;
    color: #c7d2fe;
    letter-spacing: 0.35px;
}

QLabel#uploadedRowProfile {
    font-size: 12px;
    font-weight: 700;
    color: #e9d5ff;
    letter-spacing: 0.12px;
}

QLabel#uploadedRowMetrics {
    font-size: 13px;
    font-weight: 800;
}

QLabel#uploadedRowAgo {
    font-size: 12px;
    font-weight: 800;
    color: #e0e7ff;
}

QLabel#uploadedThumb {
    background-color: #0a0c12;
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 10px;
    color: #a5b4fc;
    font-size: 11px;
    font-weight: 700;
}

QLabel#uploadedThumbEmpty {
    background-color: #1a1d26;
    border: 1px dashed rgba(129, 140, 248, 0.4);
    border-radius: 10px;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#uploadedOpenBtn {
    background-color: rgba(99, 102, 241, 0.2);
    color: #e0e7ff;
    border: 1px solid rgba(129, 140, 248, 0.55);
    border-radius: 8px;
    font-size: 16px;
    font-weight: 800;
    padding: 0;
}

QPushButton#uploadedOpenBtn:hover {
    background-color: rgba(99, 102, 241, 0.35);
    color: #ffffff;
    border-color: #a5b4fc;
}

QPushButton#uploadedOpenBtn:disabled {
    background-color: #252836;
    color: #64748b;
    border: 1px solid #3d4258;
}

QComboBox#uploadedSessionFilter {
    background-color: #0f1118;
    border: 1px solid #3d4258;
    border-radius: 10px;
    padding: 8px 12px;
    min-height: 22px;
    font-weight: 700;
    color: #f1f5f9;
}

QComboBox#uploadedSessionFilter:hover {
    border-color: #818cf8;
}

QComboBox#uploadedSessionFilter::drop-down {
    border: none;
    width: 28px;
}

QComboBox#uploadedSessionFilter QAbstractItemView {
    background-color: #151826;
    border: 1px solid #2d3142;
    selection-background-color: rgba(99, 102, 241, 0.35);
    selection-color: #f8fafc;
    font-weight: 600;
}